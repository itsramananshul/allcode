{
  "name": "all-code",
  "version": "0.1.0",
  "description": "One terminal workspace for Claude Code, OpenCode, and Codex.",
  "license": "MIT",
  "homepage": "https://github.com/itsramananshul/all-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsramananshul/all-code.git"
  },
  "bugs": {
    "url": "https://github.com/itsramananshul/all-code/issues"
  },
  "keywords": [
    "ai",
    "cli",
    "coding-agent",
    "claude-code",
    "opencode",
    "codex",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "allcode": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "node-pty": "^1.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "assets",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  }
}
