{
  "name": "allcode",
  "version": "0.3.2",
  "description": "One terminal workspace for Claude Code, OpenCode, Codex, Hermes, and more coding agents.",
  "license": "MIT",
  "homepage": "https://github.com/itsramananshul/allcode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsramananshul/allcode.git"
  },
  "bugs": {
    "url": "https://github.com/itsramananshul/allcode/issues"
  },
  "keywords": [
    "ai",
    "cli",
    "coding-agent",
    "claude-code",
    "opencode",
    "codex",
    "hermes-agent",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "allcode": "dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "node-pty": "^1.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "allowScripts": {
    "esbuild": true,
    "node-pty": true
  }
}
